{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": {
      "console": {
        "Name": "Console"
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  },
  "MqttOptions": {
    "Host": "localhost",
    "Port": 1883,
    "ClientIdPrefix": "Mqtt-ClientId-"
  },
  "AllowedHosts": "*"
}
